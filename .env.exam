# Backend
# Origen de la API. Lo leen el navegador y el servidor.
# Sin barra final (el cliente la quita igual, pero mejor no ensuciar).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origen interno del backend, solo servidor y solo en producción.
# Si el backend es alcanzable por la red privada del despliegue, ponerlo aquí
# ahorra la salida a internet en las peticiones de Server Components.
# En local NO lo definas: `NEXT_PUBLIC_API_URL` ya sirve para ambos lados.
# API_INTERNAL_URL=http://api.internal:8000

# Imágenes de producto
# Origen desde el que se sirven las fotos.
# Next solo optimiza imágenes remotas de orígenes declarados: sin esto, una URL
# del backend revienta en tiempo de ejecución. Mientras no lo definas, las
# tarjetas caen a las iniciales del producto y todo funciona igual.
# NEXT_PUBLIC_PRODUCT_IMAGES_ORIGIN=https://cdn.mi-backend.com